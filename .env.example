# ──────────────────────────────────────────────────────────────────────────
# AI Insight Digest — environment configuration
# Copy to `.env` and fill in the secrets. Never commit the real `.env`.
# ──────────────────────────────────────────────────────────────────────────

# ── Telegram ───────────────────────────────────────────────────────────────
# Bot token from @BotFather
BOT_TOKEN=123456:replace-me

# ── Google Gemini ──────────────────────────────────────────────────────────
# API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=replace-me
GEMINI_MODEL=gemini-2.5-flash
# Max news items scored via Gemini per daily run — a cost cap (best candidates
# first). On the free tier keep this at/below your daily quota.
SCORING_BUDGET=40

# ── Database ───────────────────────────────────────────────────────────────
# Async SQLAlchemy DSN. For docker-compose the host is `postgres`.
DATABASE_URL=postgresql+asyncpg://aidigest:aidigest@localhost:5432/aidigest

# ── Digest behaviour ───────────────────────────────────────────────────────
# Default schedule for newly registered chats: twice a week, Monday and Friday
# morning. DIGEST_DAYS takes ISO weekdays (1=Mon .. 7=Sun) or names (пн,пт).
DIGEST_TIME=09:00
DIGEST_DAYS=1,5
TIMEZONE=Europe/Moscow
# How many items go into one digest.
DIGEST_SIZE=5
# Minimum Gemini score (1-10) for an item to be eligible for the digest.
SCORE_THRESHOLD=7
# Push top-scored news immediately, outside the schedule. Off by default so
# nothing arrives between the two weekly deliveries.
BREAKING_ENABLED=false

# ── Ingestion ──────────────────────────────────────────────────────────────
# How often collectors run, in hours.
INGEST_INTERVAL_HOURS=3
# Window (days) of news considered relevant — collectors fetch it and the
# digest picks the best items from it. 7 = "this week's most important AI news".
LOOKBACK_DAYS=7
# Hacker News: minimum points to consider a story (anti-hype filter).
HN_MIN_SCORE=100
# Comma-separated extra RSS feeds to watch (optional).
EXTRA_RSS_FEEDS=

# ── Operators ──────────────────────────────────────────────────────────────
# Comma-separated Telegram user IDs allowed to run /stats, /run_ingest, etc.
ADMIN_IDS=

# ── Product Hunt (optional) ────────────────────────────────────────────────
# Developer token from https://www.producthunt.com/v2/oauth/applications
# Leave empty to disable the Product Hunt collector.
PRODUCTHUNT_TOKEN=

# ── Observability ──────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# true => JSON logs (production), false => pretty console logs (development)
LOG_JSON=true
